@model Property
<div class="card property-card h-100 shadow-sm">
    <a asp-page="/Listings/Details" asp-route-id="@Model.Id" class="position-relative d-block">
        <partial name="_PropertyImage" model="Model" />
        <span class="badge position-absolute top-0 start-0 m-2 @(Model.ListingType == ListingType.Sale ? "text-bg-primary" : "text-bg-success")">
            For @Model.ListingType
        </span>
    </a>
    <div class="card-body d-flex flex-column">
        <div class="price fs-5">@Model.DisplayPrice()</div>
        <h2 class="h6 card-title mt-1 mb-1">
            <a asp-page="/Listings/Details" asp-route-id="@Model.Id" class="stretched-link text-decoration-none text-body">@Model.Title</a>
        </h2>
        <div class="text-muted small mb-2">@Model.Address, @Model.City</div>
        <div class="small mt-auto">@Model.Summary()</div>
    </div>
</div>
